<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_IO_ReadWrite" Id="{2a2d3c0b-fb0c-4e37-a4a0-dec3f4819e2c}" SpecialFunc="None">
    <Declaration><![CDATA[{ attribute 'Name' := 'TC_DI-DO-Test' }
{ attribute 'Timeout' := 't#5s' }
{ attribute 'Owner' := 'BACA_Controls' }
{ attribute 'Category' := 'IO/Digital' }
FUNCTION_BLOCK FB_IO_ReadWrite
VAR_INPUT
	bExecute     : BOOL;           
	timerDelay   : TIME; 
END_VAR
VAR_OUTPUT
	bHighMatch   : BOOL;           
	bLowMatch    : BOOL;   
	bDone 		 : BOOL;        
END_VAR
VAR
	rTrigExecute : R_TRIG;
	bOut AT %Q*	 : BOOL;
	bIn  AT %I*  : BOOL;
	timer        : TON;
	eState       : (INIT, SET_TRUE, READ_TRUE, SET_FALSE, READ_FALSE);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[rTrigExecute(CLK := bExecute);

CASE eState OF
	INIT:
		bOut := FALSE;
		bHighMatch := FALSE;
		bLowMatch := FALSE;
		bDone := FALSE;
		timer.PT := timerDelay;
		IF rTrigExecute.Q THEN
			eState := SET_TRUE;
		END_IF

	SET_TRUE:
		bOut := TRUE;
		timer.IN := TRUE;
		IF timer.Q THEN
			timer.IN := FALSE;
			eState := READ_TRUE;
		END_IF;

	READ_TRUE:
		bHighMatch := (bIn = TRUE);		
		eState := SET_FALSE;

	SET_FALSE:
		bOut := FALSE;
		timer.IN := TRUE;
		IF timer.Q THEN
			timer.IN := FALSE;
			eState := READ_FALSE;
		END_IF;

	READ_FALSE:
		bLowMatch := (bIn = FALSE);
		bDone := TRUE;
		eState := INIT;
END_CASE

timer();]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>